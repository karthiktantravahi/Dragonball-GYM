# Server Execution Port (Render provides this dynamically via process.env.PORT)
PORT=5000

# Application Environment: 'development' or 'production'
NODE_ENV=development

# MongoDB Atlas Connection URI
# In MongoDB Atlas: Network Access must allow 0.0.0.0/0 for Render hosting
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/dragonball_gym?retryWrites=true&w=majority

# JWT Token Secret (Must be a secure random string in production, min 32 chars)
JWT_SECRET=replace_with_secure_random_production_secret_key_9000

# JWT Expiration Period (e.g., 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# Allowed Client Origin(s) for CORS
# Can be single URL or comma-separated list of domains without trailing slash
# Example: https://dragonball-gym.vercel.app,https://yourcustomdomain.com
CLIENT_URL=http://localhost:5173
